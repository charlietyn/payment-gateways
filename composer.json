{
  "name": "ronu/payment-gateways",
  "description": "One payment contract, three gateways: Mercado Pago Orders, Stripe PaymentIntents and PayPal Orders v2 â€” testable against the Payment Emulator Lab (Plaza, Vector, Harbor).",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/charlietyn/payment-gateways",
  "support": {
    "issues": "https://github.com/charlietyn/payment-gateways/issues",
    "source": "https://github.com/charlietyn/payment-gateways"
  },
  "keywords": ["payments", "payment-gateway", "checkout", "mercadopago", "stripe", "paypal", "webhooks", "laravel"],
  "authors": [{ "name": "RonuSoftware" }],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.8",
    "psr/simple-cache": "^2.0 || ^3.0"
  },
  "require-dev": {
    "illuminate/config": "^11.0 || ^12.0",
    "illuminate/container": "^11.0 || ^12.0",
    "illuminate/support": "^11.0 || ^12.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0",
    "vlucas/phpdotenv": "^5.6.1"
  },
  "suggest": {
    "illuminate/support": "Laravel bridge: PaymentGatewaysServiceProvider and the payment-gateways config"
  },
  "autoload": {
    "psr-4": { "Ronu\\PaymentGateways\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Ronu\\PaymentGateways\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["Ronu\\PaymentGateways\\Laravel\\PaymentGatewaysServiceProvider"]
    }
  },
  "scripts": {
    "test": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "analyse": "phpstan analyse --memory-limit=512M"
  },
  "config": { "sort-packages": true },
  "minimum-stability": "stable",
  "prefer-stable": true
}
